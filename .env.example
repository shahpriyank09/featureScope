# Recommended for repository-aware Greptile context
GREPTILE_API_KEY=
GREPTILE_MCP_URL=https://api.greptile.com/mcp

# Recommended for dependable GitHub API access; required for private repositories
GITHUB_TOKEN=

# Uses the account authenticated by `codex login`; no OpenAI API key is needed
CODEX_CLI_PATH=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_CLI_TIMEOUT_SECONDS=240

# Optional Claude-Mem integration; leave the URL empty for automatic worker discovery
CLAUDE_MEM_ENABLED=true
CLAUDE_MEM_BASE_URL=
CLAUDE_MEM_TIMEOUT_SECONDS=30

# Cache, offline mode, logging, and network timeouts
PRISM_CACHE_DIR=.cache/prism
PRISM_OFFLINE_DEMO=false
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=90
